#!/bin/sh /etc/rc.common
START=60
STOP=20
USE_PROCD=1

write_allow() {
	case "$1" in
		''|*[!0-9a-fA-F.:/]*) logger -t sane-openwrt "Invalid IP/CIDR allow entry"; return 1 ;;
	esac
	printf '%s\n' "$1" >> "$sane_dir/saned.conf.tmp"
}

prepare_config() {
	local file name
	sane_dir=/var/etc/sane-openwrt
	rm -rf "$sane_dir"
	mkdir -p "$sane_dir" || return 1
	# Expose the system's installed SANE backend configuration to this daemon.
	for file in /etc/sane.d/*; do
		[ -e "$file" ] || continue
		name="${file##*/}"
		case "$name" in
			saned.conf) continue ;;
			dll.conf) cp "$file" "$sane_dir/$name" || return 1 ;;
			*) ln -s "$file" "$sane_dir/$name" || return 1 ;;
		esac
	done
	printf 'data_portrange = 10000 - 10010\ndata_connect_timeout = 30\n' > "$sane_dir/saned.conf.tmp" || return 1
	config_list_foreach main allow write_allow || return 1
	mv "$sane_dir/saned.conf.tmp" "$sane_dir/saned.conf"
}

start_service() {
	. /lib/functions/network.sh
	local enabled interface listen
	config_load sane-openwrt
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get interface main interface lan
	network_get_ipaddr listen "$interface" || {
		logger -t sane-openwrt "Interface $interface has no IPv4 address; not starting"
		return 1
	}
	prepare_config || {
		logger -t sane-openwrt "Cannot prepare generic SANE configuration"
		return 1
	}
	procd_open_instance
	# /usr/sbin/saned is a shell wrapper that waits for its child.  procd
	# stops the wrapper PID, leaving the child listening on port 6566.
	# Supervise the actual daemon so stop/restart reaches the listener.
	procd_set_param command /usr/lib/sane/saned -l -e -b "$listen" -B 64
	procd_set_param env SANE_CONFIG_DIR="$sane_dir"
	procd_set_param user saned
	procd_set_param group scanner
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	local interface
	config_load sane-openwrt
	config_get interface main interface lan
	procd_add_reload_trigger sane-openwrt
	procd_add_interface_trigger 'interface.*' "$interface" /etc/init.d/sane-openwrt restart
}
