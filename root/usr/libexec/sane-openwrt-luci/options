#!/bin/sh

# Accept only an exact device name currently returned by SANE discovery.
device="$1"
if [ -z "$device" ] || ! scanimage -L 2>/dev/null | awk -v wanted="$device" '
  /^device `/ {
    rest=substr($0,9); end=index(rest,"\047")
    if (end > 0 && substr(rest,1,end-1) == wanted) found=1
  }
  END { exit !found }
'; then
	printf '{"output":"Select a scanner detected by SANE first."}\n'
	exit 0
fi
scanimage -A -d "$device" 2>&1 | awk '
function quote(s,    i,c,o) {
  o="\""
  for (i=1; i<=length(s); i++) {
    c=substr(s,i,1)
    if (c == "\\") o=o "\\\\"
    else if (c == "\"") o=o "\\\""
    else if (c == "\t") o=o "\\t"
    else if (c == "\n") o=o "\\n"
    else if (c == "\r") o=o "\\r"
    else if (c == "\b") o=o "\\b"
    else if (c == "\f") o=o "\\f"
    else o=o c
  }
  return o "\""
}
{ if (NR > 1) out=out "\n"; out=out $0 }
END { printf "{\"output\":%s}\n", quote(out) }
'
