#!/bin/sh

# scanimage -L emits backend-controlled text. JSON-escape it bytewise using
# BusyBox awk; no shell evaluation or caller-supplied arguments are involved.
scanimage -L 2>&1 | awk '
function quote(s,    i,c,o) {
  o="\""
  for (i=1; i<=length(s); i++) {
    c=substr(s,i,1)
    if (c == "\\") o=o "\\\\"
    else if (c == "\"") o=o "\\\""
    else if (c == "\t") o=o "\\t"
    else if (c == "\n") o=o "\\n"
    else if (c == "\r") o=o "\\r"
    else if (c == "\b") o=o "\\b"
    else if (c == "\f") o=o "\\f"
    else o=o c
  }
  return o "\""
}
{ if (NR > 1) out=out "\n"; out=out $0 }
END { printf "{\"output\":%s}\n", quote(out) }
'
